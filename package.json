{
  "name": "prosekit-extension-youtube",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.5.0",
  "description": "A ProseKit extension for embedding YouTube videos",
  "author": "ocavue <ocavue@gmail.com>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/ocavue",
  "homepage": "https://github.com/ocavue/prosekit-extension-youtube#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ocavue/prosekit-extension-youtube.git"
  },
  "bugs": "https://github.com/ocavue/prosekit-extension-youtube/issues",
  "keywords": [],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsdown && vite build --outDir out",
    "dev": "vite",
    "lint": "eslint .",
    "fix": "eslint --fix . && prettier --write .",
    "test": "vitest",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "@prosekit/core": "^0.12.2"
  },
  "peerDependenciesMeta": {
    "@prosekit/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ocavue/eslint-config": "^4.5.9",
    "@ocavue/tsconfig": "^0.7.1",
    "@prosekit/basic": "^0.9.4",
    "@prosekit/core": "^0.12.2",
    "@prosekit/extensions": "^0.17.3",
    "@types/node": "^22.19.11",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "tsdown": "^0.22.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.8"
  }
}
